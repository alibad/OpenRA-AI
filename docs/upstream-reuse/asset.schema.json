{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openra.ai/schemas/reusable-asset-provenance.schema.json",
  "title": "OpenRA AI asset provenance and directional acceptance record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "origin", "license", "generator", "assets", "verification"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "origin": { "enum": ["project-original", "compatible-upstream", "user-supplied"] },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "redistribution", "credit"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "redistribution": { "enum": ["allowed", "attribution-required", "blocked", "unknown"] },
        "credit": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "sources"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "facings", "layers"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "facings": { "type": "integer", "minimum": 1 },
          "layers": { "type": "array", "minItems": 1, "items": { "enum": ["body", "turret", "overlay"] } }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structural", "cardinal_handedness", "live_turn", "evidence"],
      "properties": {
        "structural": { "enum": ["passed", "failed", "pending"] },
        "cardinal_handedness": { "enum": ["passed", "failed", "pending"] },
        "live_turn": { "enum": ["passed", "failed", "pending"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
