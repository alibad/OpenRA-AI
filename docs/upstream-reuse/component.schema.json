{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openra.ai/schemas/reusable-component.schema.json",
  "title": "OpenRA AI reusable upstream component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "kind",
    "status",
    "sources",
    "license",
    "compatibility",
    "integration",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": [
        "actor",
        "faction",
        "trait",
        "weapon",
        "effect",
        "support-power",
        "strategy",
        "ai-module",
        "mission-pattern",
        "ui",
        "asset-pipeline"
      ]
    },
    "status": {
      "enum": ["discovered", "license-review", "compatibility-review", "adapting", "integrated", "verified", "rejected"]
    },
    "summary": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "commit", "paths"],
        "properties": {
          "project": { "type": "string" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "assets", "redistribution"],
      "properties": {
        "code": { "type": "string" },
        "assets": { "type": "string" },
        "redistribution": { "enum": ["allowed", "attribution-required", "non-commercial-only", "replacement-required", "blocked", "unknown"] },
        "attribution": { "type": "array", "items": { "type": "string" } }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_mod", "engine_api", "dependencies"],
      "properties": {
        "target_mod": { "type": "string" },
        "engine_api": { "enum": ["native", "adapter-required", "backport-required", "unknown"] },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "feature_flag"],
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "feature_flag": { "type": ["string", "null"] },
        "migration_notes": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lint", "build", "automated", "live"],
      "properties": {
        "lint": { "enum": ["pending", "passed", "failed", "not-applicable"] },
        "build": { "enum": ["pending", "passed", "failed", "not-applicable"] },
        "automated": { "enum": ["pending", "passed", "failed", "not-applicable"] },
        "live": { "enum": ["pending", "passed", "failed", "not-applicable"] },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
