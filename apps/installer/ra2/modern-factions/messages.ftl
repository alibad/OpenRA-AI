# Original project faction names and descriptions.
ra2-modern-turkey-name = Turkey
ra2-modern-turkey-description = Mobile defense. Screening depends on keeping a lightly armored support truck near the formation.
ra2-modern-iran-name = Iran
ra2-modern-iran-description = Layered denial. Long-range launchers have a minimum range and need armor and air-defense escorts.
ra2-modern-china-name = China
ra2-modern-china-description = Networked combined arms. Support vehicles are fragile; isolated tanks lose the network bonus.
ra2-modern-vehicle = Modern Vehicle
ra2-modern-aircraft = Recon Drone
ra2-modern-husk = Destroyed Recon Drone
ra2-r2qilin-name = Qilin Battle Tank
ra2-r2qilin-description = Front-line armor. Nearby Lynx reduces reload time by 15%.
ra2-r2lynx-name = Lynx Command Scout
ra2-r2lynx-description = Recon and command support. Nearby Chinese units reload 15% faster. Bonuses do not stack.
ra2-r2mantis-name = Mantis Air Defense
ra2-r2mantis-description = Mobile anti-air missiles. Cannot attack ground targets.
ra2-r2cloud-name = Cloud Recon Drone
ra2-r2cloud-description = Long-range reconnaissance with light ground attack. Vulnerable to anti-air.
ra2-r2karrar-name = Karrar Battle Tank
ra2-r2karrar-description = Durable escort tank. Strong against armor; slow to reposition.
ra2-r2raad-name = Raad Air Defense
ra2-r2raad-description = Long-range mobile air defense. Protects rocket artillery from aircraft.
ra2-r2fajr-name = Fajr Rocket Artillery
ra2-r2fajr-description = Four-rocket salvo with a minimum range. Reloads 20% faster while stationary.
ra2-r2mohajer-name = Mohajer Recon Drone
ra2-r2mohajer-description = Scouts ahead of artillery and provides light ground attack. Vulnerable to anti-air.
ra2-r2bozkir-name = Bozkir Battle Tank
ra2-r2bozkir-description = Armored spearhead. Takes 15% less damage near a Sancak support vehicle.
ra2-r2yildirim-name = Yildirim Howitzer
ra2-r2yildirim-description = Long-range mobile artillery with a minimum range. Requires an escort.
ra2-r2sancak-name = Sancak Support Vehicle
ra2-r2sancak-description = Detects cloaked units. Nearby Turkish units take 15% less damage; screens do not stack.
ra2-r2kuzgun-name = Kuzgun Recon Drone
ra2-r2kuzgun-description = Reconnaissance and light strike support. Benefits from a nearby Sancak screen.
