#!/bin/bash
set -euo pipefail

macos_dir="$(cd "$(dirname "$0")" && pwd)"
contents_dir="$(cd "$macos_dir/.." && pwd)"
resources_dir="$contents_dir/Resources"
support_root="$HOME/Library/Application Support/OpenRA"
content_root="$support_root/Content/ra/v2"
map_version="$(tr -d '\r\n' < "$resources_dir/VERSION")"
map_directory="$support_root/maps/ra/$map_version"
runtime_root="$support_root/OpenRA-AI"
mission_output="$runtime_root/generated/missions"
log_directory="$support_root/Logs/OpenRA-AI"
companion="$resources_dir/bin/openra-ai-companion"
bundled_map="$resources_dir/generated/missions/riyadh-crossing-42.oramap"
map_argument=""

install_content() {
  if [ -f "$content_root/allies.mix" ]; then
    return
  fi

  echo "Installing OpenRA's checksum-verified Red Alert freeware content..."
  local mirror_list="https://www.openra.net/packages/ra-quickinstall-mirrors.txt"
  local expected_sha1="44241f68e69db9511db82cf83c174737ccda300b"
  local archive="$TMPDIR/openra-ai-ra-quickinstall.zip"
  local downloaded=""

  while IFS= read -r mirror; do
    case "$mirror" in
      https://*)
        if curl --fail --location --silent --show-error "$mirror" --output "$archive"; then
          actual_sha1="$(shasum -a 1 "$archive" | awk '{print $1}')"
          if [ "$actual_sha1" = "$expected_sha1" ]; then
            downloaded="yes"
            break
          fi
        fi
        ;;
    esac
  done < <(curl --fail --location --silent --show-error "$mirror_list")

  if [ -z "$downloaded" ]; then
    echo >&2 "Unable to download checksum-valid Red Alert content."
    exit 1
  fi

  mkdir -p "$content_root"
  ditto -x -k "$archive" "$content_root"
  rm -f "$archive"
}

install_content
mkdir -p "$map_directory" "$mission_output" "$log_directory"

selected_map=""
if [ "${1:-}" = "--sample-map" ]; then
  selected_map="$bundled_map"
  shift
elif [ "${1:-}" != "" ] && [[ "${1}" == *.oramap ]]; then
  selected_map="$1"
  shift
fi
if [ -n "$selected_map" ] && [ -f "$selected_map" ]; then
  installed_map="$map_directory/$(basename "$selected_map")"
  cp "$selected_map" "$installed_map"
  map_argument="Launch.Map=$(basename "$installed_map")"
fi

export DOTNET_ROLL_FORWARD=Major
export OPENRA_AI_COMPANION=1
export OPENRA_AI_COMPANION_ENABLED=1
export OPENRA_AI_GRPC_PORT=9998
export OPENRA_AI_CONSOLE_URL=http://127.0.0.1:8787/
export OPENRA_AI_WORLD_STUDIO_URL=http://127.0.0.1:8788/
export OPENRA_AI_ENGINE_DIR="$resources_dir"
export OPENRA_AI_SUPPORT_DIR="$support_root"
export OPENRA_AI_VERSION="$map_version"
export OPENRA_AI_PACK_LOCK="$resources_dir/packaging/ai-pack.lock.json"
export OPENRA_AI_MODEL_ROOT="$runtime_root"
export OPENRA_AI_RUNTIME_EXECUTABLE="$resources_dir/bin/openra-ai-runtime"
export OPENRA_AI_BUNDLED_RUNTIME="$resources_dir/ai-runtime"
export OPENRA_AI_APP_LANGUAGE="${OPENRA_AI_APP_LANGUAGE:-en}"
export PYTHONUNBUFFERED=1
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8

selected_game="ra"
if [ -f "$support_root/openra-ai-game.txt" ]; then
  requested_game="$(tr -d '\r\n' < "$support_root/openra-ai-game.txt")"
  if [ "$requested_game" = "ra2" ] && [ -f "$resources_dir/mods/ra2/mod.yaml" ] &&
    [ -f "$support_root/Content/ra2/ra2.mix" ] && [ -f "$support_root/Content/ra2/language.mix" ]; then
    selected_game="ra2"
  fi
fi
game_args=("Game.Mod=$selected_game" "$@")
if [ -n "$map_argument" ]; then
  game_args+=("Game.Mod=ra" "$map_argument")
  has_launch_bots=""
  for argument in "${game_args[@]}"; do
    if [[ "$argument" == Launch.Bots=* ]]; then
      has_launch_bots="yes"
      break
    fi
  done
  if [ -z "$has_launch_bots" ]; then
    game_args+=("Launch.Bots=Multi1:normal")
  fi
fi

game_pid=""
watcher_pid=""
health_status_file=""

stop_process_tree() {
  local process_id="$1"
  local child
  while IFS= read -r child; do
    [ -n "$child" ] && stop_process_tree "$child"
  done < <(pgrep -P "$process_id" || true)
  kill "$process_id" 2>/dev/null || true
  local attempt
  for attempt in {1..20}; do
    kill -0 "$process_id" 2>/dev/null || return 0
    case "$(ps -p "$process_id" -o stat= 2>/dev/null)" in
      Z*) return 0 ;;
    esac
    sleep 0.1
  done
  kill -KILL "$process_id" 2>/dev/null || true
}

cleanup() {
  if [ -n "$watcher_pid" ] && kill -0 "$watcher_pid" 2>/dev/null; then
    stop_process_tree "$watcher_pid"
    wait "$watcher_pid" 2>/dev/null || true
  fi
  if [ -n "$game_pid" ] && kill -0 "$game_pid" 2>/dev/null; then
    stop_process_tree "$game_pid"
    wait "$game_pid" 2>/dev/null || true
  fi
  if [ -n "$health_status_file" ] && [ -f "$health_status_file" ]; then
    rm -f "$health_status_file"
  fi
}

wait_for_companion_health() {
  local timeout_seconds="${OPENRA_AI_STARTUP_TIMEOUT_SECONDS:-90}"
  local control_ready
  if ! [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
    echo >&2 "OPENRA_AI_STARTUP_TIMEOUT_SECONDS must be a positive integer."
    return 1
  fi

  local deadline=$((SECONDS + timeout_seconds))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if ! kill -0 "$watcher_pid" 2>/dev/null; then
      echo >&2 "The OpenRA AI companion exited before its control server became ready. See $log_directory/companion.err.log."
      return 1
    fi
    if curl --fail --silent --max-time 1 "${OPENRA_AI_CONSOLE_URL}health" \
      --output "$health_status_file" 2>/dev/null; then
      control_ready="$(plutil -extract control_ready raw -o - "$health_status_file" 2>/dev/null || true)"
      if [ "$control_ready" = "true" ]; then
        return 0
      fi
    fi
    sleep 0.25
  done

  echo >&2 "The OpenRA AI companion did not become ready within ${timeout_seconds}s. See $log_directory/companion.err.log."
  return 1
}

health_flag() {
  local key="$1"
  local fallback="$2"
  local value
  value="$(plutil -extract "$key" raw -o - "$health_status_file" 2>/dev/null || true)"
  if [ -z "$value" ]; then
    value="$fallback"
  fi
  case "$value" in
    1|true|TRUE|yes|YES|on|ON) echo 1 ;;
    *) echo 0 ;;
  esac
}

temp_root="${TMPDIR:-/tmp}"
health_status_file="$(mktemp "${temp_root%/}/openra-ai-health.XXXXXX")"
trap cleanup EXIT INT TERM

"$companion" watch \
  --bridge 127.0.0.1:9998 \
  --parent-pid "$$" \
  --control-port 8787 \
  --worldgen-port 8788 \
  --mission-output "$mission_output" \
  --mission-install "$map_directory" \
  --speak --voice-hotkeys \
  >>"$log_directory/companion.out.log" 2>>"$log_directory/companion.err.log" &
watcher_pid=$!

wait_for_companion_health

export OPENRA_AI_COMPANION_READY=1
export OPENRA_AI_STARTUP_ENABLED="$(health_flag enabled true)"
export OPENRA_AI_STARTUP_MUTED="$(health_flag muted false)"
export OPENRA_AI_STARTUP_AUTO_ACT="$(health_flag auto_act_enabled false)"
startup_strategy="$(plutil -extract strategy.active_native_profile raw -o - "$health_status_file" 2>/dev/null || true)"
export OPENRA_AI_STARTUP_STRATEGY="${startup_strategy:-normal}"

if [ "${#game_args[@]}" -eq 0 ]; then
  "$macos_dir/GameLauncher" >>"$log_directory/game.out.log" 2>>"$log_directory/game.err.log" &
else
  "$macos_dir/GameLauncher" "${game_args[@]}" >>"$log_directory/game.out.log" 2>>"$log_directory/game.err.log" &
fi
game_pid=$!

wait "$game_pid"
