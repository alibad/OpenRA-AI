NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-only private feedback inbox. Never prefix these with NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL=https://rtsai.net
FEEDBACK_ALLOWED_ORIGINS=https://rtsai.net,https://www.rtsai.net

# Existing Firebase project running the official Trigger Email extension.
# SMTP credentials remain in Firebase Secret Manager and never enter this app.
MAIL_FIREBASE_PROJECT_ID=your-mail-project-id
MAIL_FIREBASE_API_KEY=your-mail-project-web-api-key
MAIL_GROUP=private-mail-archive@example.com
FEEDBACK_ADMIN_EMAIL=builder@example.com

# GitHub App installation with Issues: read/write access to the private web repo.
# Use an App installation token, never a personal access token.
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=12345678
GITHUB_APP_PRIVATE_KEY=base64-encoded-github-app-private-key
GITHUB_REPO_OWNER=your-github-owner
GITHUB_REPO_NAME=your-private-web-repository
