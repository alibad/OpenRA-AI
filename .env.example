# OpenRA AI calls model capabilities through BeTenshi only.
# Provider credentials belong in BeTenshi's own environment, never here.
BETENSHI_AI_ROUTER_URL=http://127.0.0.1:4000
BETENSHI_AI_MODEL=gpt-5.5
BETENSHI_TRANSCRIBE_MODEL=openai-transcribe
BETENSHI_TTS_MODEL=openai-tts
BETENSHI_TTS_VOICE=alloy
BETENSHI_TIMEOUT_SECONDS=20
