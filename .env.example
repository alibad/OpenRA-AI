# OpenRA AI calls named capabilities through a private AI layer only.
# Provider credentials belong in the router's own environment, never here.
OPENRA_AI_ROUTER_URL=http://127.0.0.1:4000
OPENRA_AI_TEXT_MODEL=gpt-5.5
OPENRA_AI_TRANSCRIBE_MODEL=openai-transcribe
OPENRA_AI_TTS_MODEL=openai-tts
OPENRA_AI_TTS_VOICE=alloy
OPENRA_AI_ROUTER_TIMEOUT_SECONDS=20
